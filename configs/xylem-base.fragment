# The toolchain half of xylem's own defconfig, so the SDK's compiler, C
# library and kernel headers are the ones xylem's image is built with.
#
# Copied from xylem buildroot/configs/rgdsplus_defconfig at XYLEM_REF (see
# xylem.ref), with Buildroot at the version xylem's scripts/build.sh pins.
# `make check-xylem` compares these lines with xylem's file at that ref and
# fails when they drift.
#
# Left out on purpose: BR2_CCACHE (a build-speed setting; it changes no
# output, and in the SDK it would point the compiler wrapper at a cache
# directory that doesn't exist in the image), and everything that isn't the
# toolchain (kernel, boot, images, xylem's own packages).

BR2_aarch64=y
BR2_cortex_a55=y
BR2_ARM_FPU_FP_ARMV8=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_GCC_VERSION_15_X=y
BR2_KERNEL_HEADERS_6_19=y
